# Environment variables for docker-compose
# Copy this file to .env and fill in your values

# MongoDB Connection (use MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/course-subscription?retryWrites=true&w=majority

# JWT Secret (generate a secure random string)
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production

# Optional: Local MongoDB credentials (if using local MongoDB service)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=password123
