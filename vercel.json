{
    "version": 2,
    "name": "course-subscription-app",
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://course-subscription-application.onrender.com/api/$1"
        },
        {
            "src": "/[^.]+",
            "dest": "/index.html"
        }
    ],
    "env": {
        "VITE_API_URL": "https://course-subscription-application.onrender.com/api"
    },
    "build": {
        "env": {
            "VITE_API_URL": "https://course-subscription-application.onrender.com/api"
        }
    }
}